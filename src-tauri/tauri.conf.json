{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KYRO Launcher",
  "version": "0.7.6",
  "identifier": "dev.kyro.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KYRO Launcher",
        "width": 1060,
        "height": 600,
        "minWidth": 960,
        "minHeight": 600,
        "visible": true,
        "decorations": false,
        "backgroundColor": "#08070c",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://cdn.modrinth.com data:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
