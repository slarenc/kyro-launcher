{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KYRO Launcher",
  "version": "0.4.0",
  "identifier": "dev.kyro.launcher",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "KYRO Launcher", "width": 1320, "height": 850, "minWidth": 1000, "minHeight": 700, "visible": false, "decorations": false, "backgroundColor": "#08070c" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://cdn.modrinth.com data:; connect-src ipc: http://ipc.localhost; font-src 'self'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
